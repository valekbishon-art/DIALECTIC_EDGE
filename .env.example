# =============================================================================
# Dialectic Edge — .env.example
# =============================================================================
# Скопируй файл в .env и заполни значения. .env уже в .gitignore.
# Пустые ключи допустимы — без них отключаются соответствующие фичи
# (например, без TAVILY_API_KEY web-search падает на fallback).
#
# В Railway эти же переменные задаются через Settings → Variables.
# =============================================================================

# ─── Telegram ────────────────────────────────────────────────────────────────
# Токен от @BotFather. Без него бот не стартует.
BOT_TOKEN=123456:ABC-...
# Telegram user_id админов через запятую (для /audit, /stop, /starttrade и т.п.).
ADMIN_IDS=0

# ─── AI provider routing ─────────────────────────────────────────────────────
# Активный первичный провайдер (gemini | groq | mistral | openrouter | together | cerebras).
# Bull/Bear/Verifier/Synth разводятся по моделям через переменные ниже.
AI_PROVIDER=gemini

# Бесплатные / дешёвые LLM-провайдеры. Хватит даже одного, остальные — fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# Локальные / совместимые с OpenAI endpoint'ы (Ollama / LM Studio).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_API_KEY=lm-studio
OPENAI_COMPAT_MODEL=local-model

# HuggingFace token для FinBERT sentiment (опционально, без него локальный inference).
HF_TOKEN=

# ─── Дебаты ──────────────────────────────────────────────────────────────────
DEBATE_ROUNDS=3
MAX_TOKENS=1500
AGENT_TEMP=0.7

# ─── Источники данных ────────────────────────────────────────────────────────
# Все ключи бесплатные на free tier'ах.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
TAVILY_API_KEY=
NEWS_API_KEY=

# Bybit (только если используются приватные эндпоинты — публичные сигналы работают без ключа).
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# ─── State persistence в git (для рестартов без потери истории) ──────────────
# Бот коммитит DIGEST_CACHE.md / AUTO_TRACK.md / FORECASTS.md обратно в репо.
GITHUB_TOKEN=
GITHUB_REPO=ANAEHY/dialectic_edge
GITHUB_DEFAULT_BRANCH=master
GITHUB_DATA_BRANCH=data/market-cache

# ─── Хранилище (SQLite + cache) ──────────────────────────────────────────────
# На Railway монтируется Volume — путь придёт из RAILWAY_VOLUME_MOUNT_PATH автоматически.
# Локально — оставь пусто, файлы лягут в корень репо.
DATA_DIR=
DB_PATH=dialectic_edge.db
CACHE_FILE=cache.json
CACHE_TTL_HOURS=24
DEBATE_SNAPSHOT_HOURS=72

# Redis для снимков дебатов (опционально, нужен только если >1 воркера или важна
# кнопка «листать» после рестарта). Без REDIS_URL — fallback на SQLite/JSON.
REDIS_URL=

# ─── Risk / autotrade фичефлаги (см. config.py для полного списка) ───────────
FEATURE_AUTOTRADE=1
AUTOTRADE_START_CAPITAL=500.0
AUTOTRADE_INTERVAL_SEC=60
AUTOTRADE_OPEN_SCORE_THRESHOLD=18
AUTOTRADE_REVERSAL_SCORE_THRESHOLD=16
AUTOTRADE_MIN_HOLD_MINUTES=15
AUTOTRADE_REENTRY_COOLDOWN_MIN=30
LOG_AUTOTRADE_SKIPS=0

# ─── Per-agent calibration (PR #1, killer-фича 1/8) ──────────────────────────
# Отслеживает per-agent (Bull/Bear/Verifier/Synth) probabilistic forecast'ы и
# через `AGENT_CALIB_HORIZON_MIN` минут резолвит их через Brier score.
# Накопив историю, вычисляет калибровку каждого голоса (см. core/agent_calibration.py).
# По умолчанию OFF — включи когда готов начать собирать данные (4-6 недель
# нужно для накопления значимой статистики).
FEATURE_AGENT_CALIBRATION=0
# Горизонт прогноза в минутах (default 1440 = 24h).
AGENT_CALIB_HORIZON_MIN=1440
# Порог реализации в % (default 0.5: движение >= +0.5% за horizon = y=1).
AGENT_CALIB_THRESHOLD_PCT=0.5

# ─── Cross-exchange microstructure forensics (Killer 2/8) ───────────────────
# Каждые MICROSTRUCTURE_INTERVAL_SEC снимаем L2-стакан с Binance/Bybit/OKX/
# Bitget/Hyperliquid и считаем:
#   * depth-in-band (USD bid- и ask-side в полосе ±BAND_PCT% от mid)
#   * depth asymmetry (-1..+1)
#   * quoted spread (bps)
#   * liquidity vacuum (depth ниже 24h-baseline на ≥DROP_PCT)
# Sum снапшота сохраняем в SQLite (microstructure_snapshots). Сырые стаканы
# не пишем — слишком объёмно. По умолчанию OFF (накапливай 24-48h baseline,
# потом включай vacuum-сигналы в дебаты — отдельный PR).
FEATURE_MICROSTRUCTURE=0
# Активы (символы базовой валюты), которые сканируем. UPPERCASE через запятую.
MICROSTRUCTURE_SYMBOLS=BTC,ETH
# Какие venue включать. Поддерживаются: binance, bybit, okx, bitget, hyperliquid.
MICROSTRUCTURE_VENUES=binance,bybit,okx,bitget,hyperliquid
# Полоса в % от mid, в которой считаем depth (0.5 = ±0.5% вокруг mid).
MICROSTRUCTURE_BAND_PCT=0.5
# Порог vacuum: при падении depth ниже baseline на ≥ X% помечаем VACUUM.
MICROSTRUCTURE_VACUUM_DROP_PCT=40
# Интервал между snapshot'ами в секундах. Min=60.
MICROSTRUCTURE_INTERVAL_SEC=300

# ─── P2P arbitrage scanner ───────────────────────────────────────────────────
# Telegram: /p2p [ASSET] [FIAT] [payment1,payment2]
# По умолчанию ON (read-only мониторинг публичных P2P стаканов Binance и Bybit).
# Это отступление от общего правила AGENTS.md «фичефлаги OFF по умолчанию» —
# владелец явно попросил автоматическую работу сканера. Бот деньги не двигает,
# только присылает алерты про прибыльные окна; реальную сделку юзер делает
# руками после проверки мерчанта/банка/лимитов. Чтобы выключить: =0.
FEATURE_P2P_ARBITRAGE=1
# Bybit provider включён когда FEATURE_P2P_ARBITRAGE=1; set 0 чтобы сканить только Binance.
FEATURE_P2P_BYBIT=1
# Список активов и фиатов для сканирования (Cartesian product). По умолчанию
# 4 актива × 3 фиата = 12 пар (USDT/USDC/BTC/ETH × RUB/USD/EUR). Сузить можно
# через override этих переменных, например "USDT" и "RUB" для одного направления.
P2P_ARBITRAGE_ASSETS=USDT,USDC,BTC,ETH
P2P_ARBITRAGE_FIATS=RUB,USD,EUR
# Пусто = все payment methods. Примеры Binance: TinkoffNew, RosBankNew, RaiffeisenBank.
P2P_ARBITRAGE_PAY_TYPES=
# Минимальный net spread после buffer, %. Всё ниже считается шумом.
P2P_ARBITRAGE_MIN_SPREAD_PCT=1.0
# Буфер на settlement risk, комиссии/проскальзывание/зависание платежа, %.
# Legacy fallback: используется, если новые P2P_BANK_FEE_*/P2P_SLIPPAGE_PCT/P2P_CRYPTO_WITHDRAW_USDT не заданы.
P2P_ARBITRAGE_SETTLEMENT_BUFFER_PCT=0.35
# Компонентная fee-модель. Bank fee задаётся в % на payment method; ключ строится из имени метода.
P2P_BANK_FEE_DEFAULT_PCT=0
P2P_BANK_FEE_TINKOFF=0
P2P_BANK_FEE_SBER=0.5
P2P_CRYPTO_WITHDRAW_USDT=1.0
P2P_SLIPPAGE_PCT=0.25
P2P_OPPORTUNITY_TTL_SEC=120
# Risk scoring/ranking. score = net_spread_pct * risk_weight[risk_level].
P2P_RISK_WEIGHT_LOW=1.0
P2P_RISK_WEIGHT_MEDIUM=0.7
P2P_RISK_WEIGHT_HIGH=0.4
P2P_RISK_LOW_MIN_RATE=98
P2P_RISK_LOW_MIN_ORDERS=500
P2P_RISK_MEDIUM_MIN_RATE=95
P2P_RISK_MEDIUM_MIN_ORDERS=100
P2P_PAYMENT_WINDOW_WARN_MIN=15
# Фильтр качества контрагентов.
P2P_ARBITRAGE_MIN_COMPLETION_RATE_PCT=90
P2P_ARBITRAGE_MIN_ORDERS=50
P2P_ARBITRAGE_MERCHANT_ONLY=0
P2P_ARBITRAGE_MAX_RESULTS=5
# Авто-алерты админам. Требуют FEATURE_P2P_ARBITRAGE=1. По умолчанию ON, чтобы
# сканер сам присылал прибыльные окна без явного вызова /p2p (interval/cooldown
# ниже защищают от спама).
FEATURE_P2P_ARBITRAGE_ALERTS=1
P2P_ARBITRAGE_ALERT_INTERVAL_SEC=1800
P2P_ARBITRAGE_ALERT_COOLDOWN_SEC=7200
# Пусто = ADMIN_IDS. Можно задать конкретные chat_id через запятую.
P2P_ARBITRAGE_ALERT_CHAT_IDS=

# ─── P2P account-quality risk signals ────────────────────────────────────────
# Дополнительные сигналы качества аккаунта продавца (Soft #2). 0 = выключено.
# userGrade — внутренний скоринг площадки, vipLevel — обычно отражает объёмы,
# accountAgeDays — защита от свежих "прокачанных" аккаунтов.
P2P_RISK_MIN_USER_GRADE=0
P2P_RISK_MIN_VIP_LEVEL=0
P2P_RISK_MIN_ACCOUNT_AGE_DAYS=30

# ─── P2P self-audit (feedback-петля для адаптивных порогов) ──────────────────
# По умолчанию OFF. Когда включено — бот логирует каждую показанную
# opportunity в SQLite, через P2P_AUDIT_BACKCHECK_DELAY_MIN мин перечитывает
# orderbook и проверяет realised spread vs показанный. Используется командой
# `/p2paudit` для просмотра журнала + рекомендации по подстройке
# `P2P_ARBITRAGE_MIN_SPREAD_PCT`.
FEATURE_P2P_SELF_AUDIT=0
P2P_AUDIT_BACKCHECK_DELAY_MIN=60
P2P_AUDIT_BACKCHECK_INTERVAL_MIN=15
# Match tolerance: при backcheck'е считаем рекламу той же если её цена
# в пределах этого % от исходной.
P2P_AUDIT_PRICE_TOLERANCE_PCT=0.5
# Если realised отличается от shown больше чем на этот % от net_spread_pct —
# классифицируем как decayed/amplified, иначе confirmed.
P2P_AUDIT_DECAY_THRESHOLD_PCT=25.0
# Шаг адаптивной подстройки `P2P_ARBITRAGE_MIN_SPREAD_PCT` (рекомендуется).
P2P_AUDIT_THRESHOLD_ADJUST_PCT=0.1
# Минимум резолвнутых записей до выдачи рекомендации (защита от шума).
P2P_AUDIT_THRESHOLD_ADJUST_MIN_SAMPLES=10
# Hard-retention: записи старше N дней удаляются ночью по UTC.
P2P_AUDIT_RETENTION_DAYS=14

# ─── Auto-alert engine ──────────────────────────────────────────────────────
# Generic alert framework: запускает несколько правил по расписанию и шлёт
# карточки в TG админам. Использует существующий JsonAlertStore для cooldown.
# Каждое правило за отдельным sub-flag. По умолчанию весь движок выключен.
FEATURE_ALERT_ENGINE=0
ALERT_ENGINE_INTERVAL_SEC=300
# Пусто = ADMIN_IDS. Можно задать конкретные chat_id через запятую.
ALERT_ENGINE_CHAT_IDS=

# Rule: anomaly screener (RSI extremes + volume spikes + funding anomalies).
# Запускает существующий core.screener.MarketScreener в фоне и шлёт алерт на
# high-conviction (≥ 2 сигнала + 1 strong threshold).
FEATURE_ALERT_SCREENER=1
ALERT_SCREENER_TOP_N=15
ALERT_SCREENER_COOLDOWN_SEC=3600

# Rule: BTC spot-ETF outflow detector. Тянет Yahoo Finance OHLCV по
# IBIT/FBTC/BITB/ARKB/BTCO, считает basket-avg per-day change и шлёт алерт
# либо при streak ≥ N дней просадки, либо при единичной сессии > big-drop %.
FEATURE_ALERT_BTC_ETF=1
ALERT_BTC_ETF_TICKERS=IBIT,FBTC,BITB,ARKB,BTCO
ALERT_BTC_ETF_OUTFLOW_DAY_PCT=1.5
ALERT_BTC_ETF_STREAK_DAYS=3
ALERT_BTC_ETF_BIG_DAY_DROP_PCT=4.0
ALERT_BTC_ETF_COOLDOWN_SEC=21600

# Rule: liquidation magnet (OI buildup + top-trader L/S extreme = cascade
# setup). Backed by market_indicators.liquidation_magnet_io.
FEATURE_ALERT_LIQUIDATION_CLUSTER=1
ALERT_LIQUIDATION_COOLDOWN_SEC=7200
ALERT_LIQUIDATION_NOTIFY_NEUTRAL=0

# ─── Narrative drift tracker (Killer 3/8) ──────────────────────────────────
# Раз в NARRATIVE_INTERVAL_SEC подтягивает свежие новости (через TAVILY_API_KEY)
# и embed'ит каждую через Gemini text-embedding-004 (по умолчанию) или
# Mistral mistral-embed. Документы кластеризуются онлайн (cosine ≥
# NARRATIVE_CLUSTER_THRESHOLD = «same narrative»). Каждый кластер копит
# velocity (docs/h) и reach (число источников). Drift detection: cosine
# distance между текущим centroid и центроидом N-часов-назад (snapshot).
# Если drift ≥ NARRATIVE_DRIFT_THRESHOLD → WARNING в логах.
# Все запросы используют существующие ключи GEMINI_API_KEY / MISTRAL_API_KEY,
# новых ключей не нужно.
FEATURE_NARRATIVE_DRIFT=0
# Какой provider использовать первым (gemini | mistral). Fallback автоматический.
NARRATIVE_EMBEDDING_PROVIDER=gemini
# Cosine similarity для join'а к существующему кластеру (0.0 - 1.0).
# 0.70 — same narrative; <0.70 — создаём новый кластер.
NARRATIVE_CLUSTER_THRESHOLD=0.70
# Cosine distance для drift event (0.0 - 2.0). 0.20 = заметный сдвиг.
NARRATIVE_DRIFT_THRESHOLD=0.20
# Окно для расчёта velocity (часы).
NARRATIVE_VELOCITY_WINDOW_H=24
# Anchor-snapshot для drift detection — N часов назад.
NARRATIVE_DRIFT_ANCHOR_H=72
# Минимум docs в кластере для drift-judgment (фильтр шума).
NARRATIVE_MIN_CLUSTER_DOCS=3
# Интервал между ingest-итерациями в секундах. Min=300.
NARRATIVE_INTERVAL_SEC=3600
# Retention: документы и snapshots старше N дней удаляются daily-cleanup.
NARRATIVE_RETENTION_DAYS=180
# Max docs за одну embed-батч (защита от rate limits).
NARRATIVE_MAX_DOCS_PER_BATCH=50

# ─── Funding term structure (Tier A #4) ─────────────────────────────────────
# Каждые FUNDING_TERM_INTERVAL_SEC собирает: текущий perp funding rate
# (Bybit + Binance, 8h period, annualized), 30-day basis carry (если есть
# месячный фьючерс) и 90-day basis carry (Bybit linear delivery + Binance
# Coin-M quarterly). Считаем slope = quarterly - spot. Inversion event,
# когда slope меняет знак с + (contango) на - (backwardation) — stress
# signal, как inverted yield curve в TradFi.
# Пишет снимок в funding_term_snapshots (asset, ts, spot/30d/90d annual,
# slope, is_inverted, venues_csv).
# По умолчанию OFF (накапливай 1-2 недели baseline, потом смотри events).
FEATURE_FUNDING_TERM=0
# Какие активы сканируем. UPPERCASE через запятую.
FUNDING_TERM_SYMBOLS=BTC,ETH
# Интервал между snapshot'ами в секундах. Min=300.
FUNDING_TERM_INTERVAL_SEC=1800

# ─── Options skew (Tier A #7) ────────────────────────────────────────────────
# Каждые OPTIONS_SKEW_INTERVAL_SEC собирает Deribit public API:
# get_book_summary_by_currency (option-инструменты с mark_iv) + index_price.
# Считаем:
#   - ATM IV для near (~7d) и far (~30d) expiries (среднее коллов и путов
#     ближайших к spot страйков),
#   - 25-delta risk reversal = IV(25Δ call) - IV(25Δ put) (доля, не vol pts;
#     отрицательный = put skew = crash hedging, положительный = call skew =
#     FOMO),
#   - ATM IV term slope = far_iv - near_iv (отрицательный = near IV выше
#     дальней = near-term stress, backwardation).
# Black-Scholes без r (stdlib only, math.erf). Пишет в options_skew_snapshots.
# По умолчанию OFF (накапливай 1-2 недели baseline, потом смотри events).
FEATURE_OPTIONS_SKEW=0
# Какие валюты опционов мониторим (Deribit поддерживает BTC, ETH, SOL).
OPTIONS_SKEW_SYMBOLS=BTC,ETH
# Интервал между snapshot'ами в секундах. Min=300.
OPTIONS_SKEW_INTERVAL_SEC=1800

# ─── Stablecoin flows (Tier A #8) ────────────────────────────────────────────
# Каждые STABLECOIN_FLOWS_INTERVAL_SEC снимает totalSupply стейблов:
#   - Ethereum через Etherscan (USDT 0xdAC1..., USDC 0xA0b8...). Требует
#     ETHERSCAN_API_KEY (free tier 5 calls/sec).
#   - Tron через Tronscan public API (без ключа).
# Считаем 24h delta supply per token (сумма по chains) и классифицируем:
#   * massive_mint (≥ +1.0% supply за 24ч) / mint (≥ +0.25%)
#   * neutral
#   * redeem (≤ -0.25%) / massive_redeem (≤ -1.0%)
# По умолчанию OFF. Включить:
FEATURE_STABLECOIN_FLOWS=0
# Какие токены опрашивать (через запятую). Поддерживаются: USDT, USDC, DAI, FRAX.
STABLECOIN_FLOWS_TOKENS=USDT,USDC
# Интервал между snapshot'ами в секундах. Min=300. Дефолт=3600 (раз в час).
STABLECOIN_FLOWS_INTERVAL_SEC=3600
# Etherscan free API key (https://etherscan.io/myapikey). Без него Ethereum
# chain пропускается, остаётся только Tron-часть.
ETHERSCAN_API_KEY=

# ─── Regime classifier (BOCPD + label) ──────────────────────────────────────
# Bayesian Online Changepoint Detection (Adams & MacKay 2007) над log-returns
# BTC 1h. Производит регулярную классификацию: trending / ranging / volatile /
# crisis. Используется как meta-signal в дебатах: trending = momentum-сигналы
# работают; ranging = contrarian / mean-reversion; crisis = defensive sizing.
# Источник данных — публичный Binance Spot klines (без ключей).
# По умолчанию OFF — соберите 1-2 недели baseline, посмотрите на label'ы в
# дайджесте, потом включайте в scoring.
FEATURE_REGIME_CLASSIFIER=0
# Размер окна для label'инга (последние N часов). Min=12, max=168.
REGIME_LABEL_WINDOW=24
# Hazard rate для BOCPD — ожидаемая частота changepoint'ов на шаг. 1/200
# = ожидаемая длина сегмента 200 часов (≈ 8 дней). Чем ниже — тем
# консервативнее детекция changepoint'ов. Min=0+, max=1-.
REGIME_HAZARD_RATE=0.005
# Порог annualized volatility, выше которого режим = volatile/crisis. 1.2
# ≈ 120% годовых (для BTC исторически 60-90% — норма, 120%+ — стресс).
REGIME_VOL_HIGH_ANNUALIZED=1.2
# Сколько 1h-баров тянуть с Binance. 500 ≈ 21 день. Min=50, max=1000.
REGIME_KLINES_LIMIT=500

# ─── Smart-money wallets (on-chain ETH flows via Etherscan v2) ──────────────
# Отслеживание net ETH inflow/outflow по списку публично-атрибутированных
# институциональных кошельков (Jump Trading, Wintermute, Cumberland, Galaxy,
# GSR, Amber, FalconX, Flow Traders). Сигнал leading-индикатор: smart money
# часто опережают ценовое движение на 6-24ч.
# Конвенция знаков:
#   net > 0 (accumulating) → bullish (кошельки покупают ETH)
#   net < 0 (distributing) → bearish (кошельки продают ETH)
# Использует Etherscan API v2 (chainid=1 для Ethereum mainnet). Требует
# ETHERSCAN_API_KEY (тот же, что для stablecoin flows).
# По умолчанию OFF.
FEATURE_SMART_MONEY_WALLETS=0
# Окно агрегации в часах (1..168). Default=24.
SMART_MONEY_WALLETS_LOOKBACK_HOURS=24
# Минимальный net flow per-wallet в ETH, ниже которого = «дрейф/газ» (не сигнал).
SMART_MONEY_WALLETS_NOISE_FLOOR_ETH=10
# Порог aggregate flow для классификации accumulating/distributing (ETH).
SMART_MONEY_WALLETS_FLOW_THRESHOLD_ETH=1000
# Порог aggregate flow для is_strong_signal=True (ETH). Score: ±2 vs ±1.
SMART_MONEY_WALLETS_STRONG_FLOW_THRESHOLD_ETH=5000
# Доля выровненных wallets для strong signal (0..1). 0.75 = 6 из 8 в одну сторону.
SMART_MONEY_WALLETS_ALIGNMENT_THRESHOLD=0.75
# Пауза между API-вызовами в секундах (free tier Etherscan = 5/sec, 0.2s safe).
# 0 = без паузы. Default=0.
SMART_MONEY_WALLETS_INTER_CALL_DELAY_S=0
# Опциональный override registry: address:label через запятую.
# Если задан — ПОЛНОСТЬЮ заменяет default. Адреса любого регистра.
# Пример: 0x1111...1111:MyWallet,0x2222...2222:Other
SMART_MONEY_WALLETS_ADDRESSES=

# ─── Liquidation magnet (leveraged positioning + OI velocity) ───────────────
# Контрарианский сигнал: когда top-трейдеры экстремально позиционированы и
# OI быстро растёт, рынок «магнитит» к ценам массовой ликвидации
# (longs flush down / shorts squeeze up).
# Источники (публичные, без ключей):
#   Binance fapi: openInterestHist + topLongShortPositionRatio
#   Bybit v5: market/open-interest (fallback OI only)
# Конвенция знаков:
#   UP_MAGNET (shorts перегружены) → bullish ST
#   DOWN_MAGNET (longs перегружены) → bearish ST
# По умолчанию OFF.
FEATURE_LIQUIDATION_MAGNET=0
# Symbol для anализа. Default BTCUSDT.
LIQUIDATION_MAGNET_SYMBOL=BTCUSDT
# Period для OI snapshots: 5m,15m,30m,1h,2h,4h,6h,12h,1d. Default 1h.
LIQUIDATION_MAGNET_PERIOD=1h
# Окно для OI velocity в часах (1..168). Default 24.
LIQUIDATION_MAGNET_LOOKBACK_HOURS=24
# Порог OI buildup % за lookback окно для активации magnet. Default 10.0.
LIQUIDATION_MAGNET_OI_BUILDUP_PCT=10.0
# Порог OI buildup % для is_strong_signal. Default 25.0.
LIQUIDATION_MAGNET_OI_BUILDUP_STRONG_PCT=25.0
# Порог L/S ratio для «heavily long» (DOWN_MAGNET). Default 1.7.
LIQUIDATION_MAGNET_LS_LONG_HEAVY=1.7
# Порог L/S ratio для «extreme long» (strong DOWN_MAGNET). Default 2.5.
LIQUIDATION_MAGNET_LS_LONG_EXTREME=2.5
# Порог L/S ratio для «heavily short» (UP_MAGNET). Default 0.6.
LIQUIDATION_MAGNET_LS_SHORT_HEAVY=0.6
# Порог L/S ratio для «extreme short» (strong UP_MAGNET). Default 0.4.
LIQUIDATION_MAGNET_LS_SHORT_EXTREME=0.4

# ─── Cascade post-mortem (auto-log) ──────────────────────────────────────────
# Авто-лог каскадных ликвидаций: WS-listener Binance + Bybit аккумулирует
# публичные liquidations в SQLite, agg-loop раз в минуту проверяет окно 24ч /
# 4ч. При превышении порога — собирает snapshot индикаторов (regime,
# liquidation magnet, smart-money wallets, BTC ETF flow, funding term,
# options skew) и постит в TG «что МЫ видели / что ПРОПУСТИЛИ / action items».
# Просмотр истории: /postmortem, /postmortem list, /postmortem <id|date>.
# По умолчанию OFF.
FEATURE_CASCADE_POST_MORTEM=0
# Порог 24ч rolling в USD. Default 500_000_000 ($500M).
POST_MORTEM_THRESHOLD_USD=500000000
# Порог 4ч rolling acute в USD (быстрая реакция на острые каскады). Default 200_000_000.
POST_MORTEM_ACUTE_THRESHOLD_USD=200000000
# Anti-spam cooldown в часах между post-mortem'ами. Default 6.
POST_MORTEM_COOLDOWN_HOURS=6
# Интервал агрегационного loop'а в секундах (15..600). Default 60.
POST_MORTEM_AGG_INTERVAL_S=60
# Сколько дней хранить сырой liquidation_events (после rolling-окна не нужны). Default 7.
POST_MORTEM_RETENTION_DAYS=7
# Sub-flag: включить Binance WS listener (default ON если фича включена).
POST_MORTEM_BINANCE_ENABLED=1
# Sub-flag: включить Bybit WS listener (default ON если фича включена).
POST_MORTEM_BYBIT_ENABLED=1
# Символы для подписки Bybit allLiquidation (per-symbol). Default top-5.
POST_MORTEM_BYBIT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
# Override WS URLs (для тестов или прокси). Дефолты — публичные эндпоинты.
POST_MORTEM_BINANCE_WS_URL=wss://fstream.binance.com/ws/!forceOrder@arr
POST_MORTEM_BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# ─── Прочее ──────────────────────────────────────────────────────────────────
# Принудительно отключить SSL-проверку Росстата (на Railway случается, использовать осознанно):
RUSSIA_ROSSTAT_INSECURE_SSL=
# Принудительно отключить SSL-проверку CFTC (COT data):
COT_INSECURE_SSL=
# Сколько реплик у Railway worker'a (используется в guard'е main.py).
RAILWAY_REPLICA_COUNT=1
